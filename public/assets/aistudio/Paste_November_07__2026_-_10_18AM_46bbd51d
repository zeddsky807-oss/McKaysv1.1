class SalesTab extends StatefulWidget {
  const SalesTab({super.key});

  @override
  State<SalesTab> createState() => _SalesTabState();
}

class _SalesTabState extends State<SalesTab> {
  final List> _customStockItems = [
    {'name': 'DHL Blue Desiro', 'ml': 30, 'price': 90000}
  ];
  final NumberFormat _currencyFormat = NumberFormat.currency(locale: 'id_ID', symbol: 'Rp ', decimalDigits: 0);

  // Fitur Tambah Item Stock Manual & Pilihan Botol
  void _showAddManualItemDialog() {
    final nameCtrl = TextEditingController();
    String selectedBotol = '30ml';
    final List<String> botolOptions = ['10ml', '15ml', '20ml', '30ml', '50ml', '100ml'];
    final priceCtrl = TextEditingController(text: '0');

    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: const Text('Tambah Item Stok & Pilih Botol'),
              content: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  TextField(controller: nameCtrl, decoration: const InputDecoration(labelText: 'Nama Produk / Item Stok')),
                  const SizedBox(height: 12),
                  DropdownButtonFormField<String>(
                    value: selectedBotol,
                    decoration: const InputDecoration(labelText: 'Pilihan Ukuran Botol'),
                    items: botolOptions.map((b) => DropdownMenuItem(value: b, child: Text(b))).toList(),
                    onChanged: (val) => setDialogState(() => selectedBotol = val!),
                  ),
                  const SizedBox(height: 12),
                  TextField(controller: priceCtrl, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Harga Jual (Mulai dari 0)', prefixText: 'Rp ')),
                ],
              ),
              actions: [
                TextButton(onPressed: () => Navigator.pop(context), child: const Text('Batal')),
                ElevatedButton(
                  style: ElevatedButton.styleFrom(backgroundColor: const Color(0xFF1E3A8A), foregroundColor: Colors.white),
                  onPressed: () {
                    final int mlValue = int.parse(selectedBotol.replaceAll('ml', ''));
                    setState(() {
                      _customStockItems.add({
                        'name': nameCtrl.text.isNotEmpty ? nameCtrl.text : 'Parfum Custom',
                        'ml': mlValue,
                        'price': double.tryParse(priceCtrl.text) ?? 0.0,
                      });
                    });
                    Navigator.pop(context);
                  },
                  child: const Text('Simpan Stok & Jual'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Kasir & Tambah Item Manual'), backgroundColor: Colors.transparent),
      body: Column(
        children: [
          Padding(
            padding: const EdgeInsets.all(16.0),
            child: ElevatedButton.icon(
              style: ElevatedButton.styleFrom(
                backgroundColor: const Color(0xFF1E3A8A),
                foregroundColor: Colors.white,
                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
                minimumSize: const Size(double.infinity, 50),
              ),
              onPressed: _showAddManualItemDialog,
              icon: const Icon(Icons.add_box),
              label: const Text('Tambah Item Stok & Varian Botol'),
            ),
          ),
          Expanded(
            child: ListView.builder(
              itemCount: _customStockItems.length,
              itemBuilder: (context, index) {
                final item = _customStockItems[index];
                return Card(
                  margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 6),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
                  child: ListTile(
                    title: Text(item['name'], style: const TextStyle(fontWeight: FontWeight.bold)),
                    subtitle: Text('Varian Botol: ${item['ml']}ml'),
                    trailing: Text(_currencyFormat.format(item['price']), style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.green)),
                  ),
                );
              },
            ),
          ),
          const SizedBox(height: 80),
        ],
      ),
    );
  }
}

