Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  
  const googleApiKey = String.fromEnvironment('GOOGLE_API_KEY', defaultValue: '');
  const geminiApiKey = String.fromEnvironment('GEMINI_API_KEY', defaultValue: '');
